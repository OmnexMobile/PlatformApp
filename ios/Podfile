require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '15.1'
prepare_react_native_project!

# Flipper setup
begin
  require 'flipper/configuration'
  flipper_config = ENV['NO_FLIPPER'] == "1" ? FlipperConfiguration.disabled : FlipperConfiguration.enabled
rescue LoadError
  puts "Flipper is not available, disabling..."
  flipper_config = nil
end

# Optional: use_frameworks
linkage = ENV['USE_FRAMEWORKS']
use_frameworks! :linkage => linkage.to_sym if linkage

target 'IntegratedApp' do
  config = use_native_modules!

  # Include React Native & react-native-permissions scripts
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Legacy lib
  pod 'react-native-fetch-blob', :path => '../node_modules/react-native-fetch-blob' do
  podspec = '../node_modules/react-native/React.podspec'
  pod 'React-Core', :path => podspec
  pod 'React-RCTBlob', :path => podspec
  pod 'React-bridging', :path => podspec
end

  # Setup react-native-permissions
  node_require = lambda do |script|
    require Pod::Executable.execute_command('node', ['-p', "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
  end
  node_require.call('react-native-permissions/scripts/setup.rb')
  setup_permissions([
    'Camera',
    'Microphone',
    'LocationWhenInUse',
    'PhotoLibraryAddOnly',
    # Add more if needed
  ])

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], :mac_catalyst_enabled => false)

    # --- Custom Post-Install tweaks ---
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          # Force iOS deployment target
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
          # Header search paths
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_ROOT}/../../node_modules/react-native/ReactCommon" '
        end
      end
    end
  end
end
